{
  "$schema": "https://opencode.ai/config.json",
  "model": "venice/kimi-k3",
  "default_agent": "researcher",
  "agents": {
    "researcher": {
      "mode": "primary",
      "description": "Primary research agent. Plans work, delegates web search, writes and organizes files, saves provenance, and records changes in git.",
      "model": "venice/deepseek-v4-1-flash",
      "system": "{file:./prompts/researcher.md}",
      "request": {
        "body": {
          "temperature": 0.2
        }
      },
      "color": "#fab283",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "codesearch", "resource": "*", "effect": "deny" },
        { "action": "doom_loop", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "lsp", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "web-searcher", "effect": "allow" },
        { "action": "todowrite", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "deny" }
      ]
    },
    "web-searcher": {
      "mode": "subagent",
      "hidden": true,
      "description": "Web-only search subagent for a single research thread. Runs several query variations, fetches high-signal pages, and returns a concise evidence bundle.",
      "model": "venice/deepseek-v4-1-flash",
      "system": "{file:./prompts/web-searcher.md}",
      "request": {
        "body": {
          "temperature": 0.2
        }
      },
      "color": "#7dcfff",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "codesearch", "resource": "*", "effect": "deny" },
        { "action": "doom_loop", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "**/runs/**", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "glob", "resource": "*", "effect": "deny" },
        { "action": "grep", "resource": "*", "effect": "deny" },
        { "action": "list", "resource": "*", "effect": "deny" },
        { "action": "lsp", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "todowrite", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" }
      ]
    }
  }
}
